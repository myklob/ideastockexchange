---
interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/belief', label: 'Belief' },
  { href: '/battlefield', label: 'Battlefield' },
  { href: '/arena', label: 'Arena' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} • Idea Stock Exchange</title>
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/">Idea Stock Exchange</a>
        <nav aria-label="Primary">
          {links.map((l) => (
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #0b0f14; --panel: #121922; --panel-2: #0e141c; --ink: #e7eef7; --muted: #a9b4c2;
    --line: #223044; --pro: #18b57a; --con: #e25555; --accent: #5ba3ff; --warn: #ffc857;
    --info: #7dd3fc; --radius: 16px; --shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
  }
  html, body {
    margin: 0; background: var(--bg); color: var(--ink);
    font: 400 16px/1.5 system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, Arial, sans-serif;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .wrap { max-width: 1100px; margin: auto; padding: 24px; }
  .top { border-bottom: 1px solid var(--line); background: var(--panel-2); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-top: 12px; padding-bottom: 12px; }
  .brand { font-weight: 700; color: var(--ink); }
  .top nav { display: flex; gap: 16px; font-size: 14px; }
  .top nav a { color: var(--muted); }
  .top nav a[aria-current='page'] { color: var(--ink); font-weight: 600; }
  h1, h2, h3 { line-height: 1.2; margin: 0 0 8px; }
  h1 { font-size: 32px; } h2 { font-size: 24px; } h3 { font-size: 18px; }
  .muted { color: var(--muted); }
  .card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); }
  .pad { padding: 16px; }
  .tag { display: inline-block; border: 1px solid var(--line); border-radius: 999px; padding: 2px 8px; font-size: 12px; color: var(--muted); }
  .pro { color: var(--pro); } .con { color: var(--con); }
  kbd { background: var(--panel-2); border: 1px solid var(--line); border-radius: 6px; padding: 1px 6px; font-size: 12px; }
  button { font: inherit; }
</style>
