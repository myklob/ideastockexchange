# Idea Stock Exchange Configuration
# Copy this file to .env and fill in your values

# ─── Database ───────────────────────────────────────────────────
# SQLite (local development) — canonical path, must match prisma.config.ts and src/lib/prisma.ts
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL (production / Vercel) — set these in the host's env vars instead of the SQLite URL above.
# DATABASE_URL          = the POOLED connection string (Neon: the "-pooler" host) for the app runtime
# DATABASE_URL_UNPOOLED = the DIRECT connection string for schema operations (prisma db push, db:bootstrap)
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/db?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/db?sslmode=require"
# DATABASE_POOL_MAX=2   # connections per serverless instance (default 2 on Vercel, 10 elsewhere)

# ─── Production secrets (required on a public deployment) ───────
# Operator bearer for the settlement cron and recompute/destructive routes: openssl rand -hex 32
# CRON_SECRET=""
# Signs the /demo playground's review tokens: openssl rand -hex 32
# DEMO_REVIEW_SECRET=""
# Public site URL, used by robots.txt and sitemap.xml
# NEXT_PUBLIC_APP_URL="https://your-domain.example"

# ─── Feature switches (production defaults shown) ───────────────
# PUBLIC_WRITES_DISABLED=1   # pause every anonymous write route (reads stay open)
# DEMO_WRITES_DISABLED=1     # pause only the /demo playground
# MARKET_WRITES_ENABLED=1    # open play-money trading (off in production until identity exists)
# AI_GENERATION_ENABLED=1    # allow the public AI topic generator (paid; off in production by default)
# ALLOW_EPOCH_BACKFILL=1     # let the cron route run past epochs (normally only the latest)
# ORACLE_PRIVATE_KEY_PEM=""  # Ed25519 PKCS8 PEM for signed attestations: openssl genpkey -algorithm ed25519

# ─── Next.js ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# ─── NLP & Embeddings ───────────────────────────────────────────
EMBEDDING_MODEL="all-MiniLM-L6-v2"
SIMILARITY_THRESHOLD=0.75
MAX_SIMILAR_STATEMENTS=10

# ─── Topic Extraction ───────────────────────────────────────────
TOPIC_EXTRACTION_METHOD="semantic"
MIN_OVERLAP_SCORE=0.0
MAX_TOPICS_PER_STATEMENT=10

# ─── TopicRank Formula Weights ──────────────────────────────────
# These weights must sum to 1.0
OVERLAP_WEIGHT=0.50
TRUTH_WEIGHT=0.30
DISAGREEMENT_BOOST=0.10
RECENCY_WEIGHT=0.10

# ─── API Configuration ──────────────────────────────────────────
MAX_RESULTS_PER_PAGE=20
API_PREFIX="/api/v1"

# ─── AI Provider (for debate topic generation) ──────────────────
# Provider: "anthropic" | "openai" | "ollama"
AI_PROVIDER="anthropic"
AI_API_KEY="your-api-key-here"
# Model to use (e.g. "claude-sonnet-4-6", "gpt-4o", "llama3")
AI_MODEL="claude-sonnet-4-6"
# Base URL override (leave blank for default; required for Ollama: http://localhost:11434)
AI_API_BASE=""
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_TIMEOUT=120000   # milliseconds (values under 1000 are read as seconds)
